# App
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/email_service?schema=public

# Redis / BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379

# Provider selection
PRIMARY_PROVIDER=smtp
FALLBACK_PROVIDER=sendgrid

# SendGrid
SENDGRID_API_KEY=SG.xxxxx

# AWS SES
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# SMTP (mailhog defaults for local dev)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Defaults
DEFAULT_FROM=no-reply@example.com

# Unsubscribe JWT
JWT_SECRET=change-me-in-production

# Rate limits (per provider)
SENDGRID_RATE_PER_MIN=600
SES_RATE_PER_SEC=14
